# 邮箱服务
# 可选值: cloudflare / duckmail / onlinemail
EMAIL_PROVIDER=cloudflare

# Cloudflare 自定义邮箱 API
EMAIL_API_URL=https://your-mail-api.example.com
EMAIL_API_TOKEN=replace-with-your-token
EMAIL_DOMAIN=example.com
EMAIL_DOMAINS=example.com,example.org

# DuckMail API
# 公共域名可不填 DUCKMAIL_API_KEY；如果你有 DuckMail 私有域名 API Key，
# 直接填进来即可。
DUCKMAIL_API_URL=https://api.duckmail.sbs
DUCKMAIL_API_KEY=
DUCKMAIL_DOMAIN=
DUCKMAIL_DOMAINS=

# OnlineDispoMail 接码平台
# 官网: https://online-disposablemail.com
# mode: file = 从文件读取已购买的邮箱; api = 实时通过 API 购买
ONLINEMAIL_MODE=file
# api 模式必填，file 模式可留空
ONLINEMAIL_API_KEY=
# file 模式必填：每行格式 email----orderId
ONLINEMAIL_ORDERS_FILE=onlinemail_orders.txt
# buyMode: 0=收到验证码后扣费(推荐), 1=购买时立即扣费(无并发限制)
ONLINEMAIL_BUY_MODE=0

# 可选：注册完成后上传到你自己的 key 池
SERVER_URL=https://your-server.example.com
SERVER_ADMIN_PASSWORD=replace-with-your-admin-password
DEFAULT_UPLOAD=true

# 运行参数
DEFAULT_COUNT=1
DEFAULT_CONCURRENCY=2
DEFAULT_DELAY=10
REGISTER_HEADLESS=true
FIRECRAWL_REGISTER_HEADLESS=true
YOU_REGISTER_HEADLESS=true
SERPER_REGISTER_HEADLESS=true
VALYU_REGISTER_HEADLESS=true
EMAIL_CODE_TIMEOUT=90
API_KEY_TIMEOUT=20
EMAIL_POLL_INTERVAL=3

# Solver
SOLVER_PORT=5073
# 实际启动时会自动取 max(SOLVER_THREADS, 本轮并发数)
SOLVER_THREADS=1

# 代理配置（可选）
# 格式: scheme://[user:pass@]host:port，多个用英文逗号分隔
# 支持 http / https / socks5
# PROXY_ENABLED=false 时忽略 PROXY_LIST，直接走本地网络
# PROXY_GEOIP=true 时 Camoufox 会通过代理发出一次 IP 探测请求（约 10 秒延迟），
# 并自动欺骗 WebRTC/geolocation fingerprint；设为 false 则跳过探测但控制台会有 LeakWarning
PROXY_ENABLED=false
PROXY_LIST=socks5://user:pass@1.2.3.4:1080,http://user:pass@5.6.7.8:8080
PROXY_GEOIP=true

# ─── Web 管理服务 ──────────────────────────────────────────────────────────────
# 管理界面登录用户名和密码
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=changeme
# JWT 签名密钥，生产环境请替换为随机长字符串
WEB_SECRET_KEY=change-this-to-a-random-secret-string
# Web 服务监听端口
WEB_PORT=8086

# 数据库配置（二选一）
# DB_TYPE=sqlite   使用本地 SQLite 文件（默认，开发/单机推荐）
# DB_TYPE=postgresql  使用 PostgreSQL（生产/多实例推荐）
DB_TYPE=sqlite
# SQLite 数据库文件路径（DB_TYPE=sqlite 时生效）
DB_PATH=web/data.db
# PostgreSQL 连接 URL（DB_TYPE=postgresql 时生效）
# 格式: postgresql+asyncpg://user:password@host:port/dbname
DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/tavily_keys
